# haben-db on Railway: official tristanteu/haben-db 0.6.5 (postgres:18 + auto pg_upgrade).
# Plain defaults are baked in because Railway templates only keep references and secrets.
FROM docker.io/tristanteu/haben-db:0.6.5
LABEL org.opencontainers.image.source="https://github.com/onepush-dev/haben"
ENV POSTGRES_USER=haben \
    POSTGRES_DB=haben
